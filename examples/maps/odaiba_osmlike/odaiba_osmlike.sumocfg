<?xml version='1.0' encoding='UTF-8'?>
<configuration>

    <input>
        <net-file value="odaiba_osmlike.net.xml" />
        <route-files value="odaiba_osmlike.trips.xml" />
        <step-length value="0.1" />
    </input>

    <time>
        <begin value="0" />
        <end value="36000" />
    </time>

    <random_number>
        <random value="true" />
    </random_number>

    <processing>
        <time-to-teleport value="-1" />
        <collision.action value="warn" />
        <collision.check-junctions value="true" />
        <collision.mingap-factor value="0" />
    </processing>

    <gui_only>
        <start value="true" />
    </gui_only>
</configuration>
