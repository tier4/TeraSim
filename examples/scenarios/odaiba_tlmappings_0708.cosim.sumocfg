<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="/app/examples/maps/odaiba_ll2/tlmappings_0708/network.net.xml"/>
    <route-files value="/app/examples/maps/odaiba_ll2/tlmappings_0708/period_0p2_filter_check/vehicles.filtered_r300.rou.xml"/>
    <step-length value="0.1"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="3600"/>
  </time>
  <processing>
    <lateral-resolution value="0.5"/>
    <time-to-teleport value="-1"/>
    <collision.action value="warn"/>
    <collision.check-junctions value="true"/>
    <collision.mingap-factor value="0"/>
  </processing>
  <report>
    <verbose value="true"/>
    <no-step-log value="true"/>
  </report>
</configuration>
